---
// Hero figure: a goal leaves your code, passes the guard, goes through Station to the servo,
// and the servo's state comes back on a stream. Every third goal is unsafe and stops at the guard.
const P = 'M118 112 H186 M262 112 H330 M434 112 H486 M562 112 H612';
---
<figure class="sp" aria-label="A motor goal travels from your code through a guard and Station to the servo, and the joint state streams back">
  <svg viewBox="0 0 760 250" width="760" height="250" role="img">
    <title>Your code sends a goal, Station moves the servo, the state streams back</title>
    <g font-family="IBM Plex Mono, monospace" font-size="11" font-weight="600" text-anchor="middle" fill="#2B2638">
      <rect x="8" y="80" width="110" height="64" rx="14" fill="var(--pop-butter)" />
      <text x="63" y="106">your code</text>
      <text x="63" y="124" font-weight="400">j2 → 0.62</text>

      <rect class="guard" x="186" y="86" width="76" height="52" rx="12" fill="var(--pop-mint)" />
      <text x="224" y="110">guard</text>
      <text x="224" y="126" font-weight="400">limits</text>

      <rect x="330" y="60" width="104" height="104" rx="18" fill="var(--pop-lilac)" />
      <text x="382" y="100">Station</text>
      <text x="382" y="118" font-weight="400">TCP 8888</text>
      <text x="382" y="134" font-weight="400">NormFS</text>

      <rect x="486" y="86" width="76" height="52" rx="12" fill="var(--pop-peach)" />
      <text x="524" y="110">bus</text>
      <text x="524" y="126" font-weight="400">serial</text>
    </g>

    <!-- the arm: a servo at the base, two links that nod as goals arrive -->
    <g transform="translate(640 150)">
      <rect x="-22" y="0" width="70" height="14" rx="5" fill="var(--ink)" />
      <g class="arm">
        <rect x="-10" y="-22" width="28" height="26" rx="6" fill="var(--pop-sky)" stroke="var(--ink)" stroke-width="2" />
        <g class="l1"><animateTransform attributeName="transform" type="rotate" values="-4 4 -10;7 4 -10;-4 4 -10" dur="1.2s" repeatCount="indefinite" />
          <path d="M4 -10 L 4 -72" stroke="var(--ink)" stroke-width="7" stroke-linecap="round" />
          <circle cx="4" cy="-72" r="7" fill="var(--pop-sky)" stroke="var(--ink)" stroke-width="2" />
          <g class="l2"><animateTransform attributeName="transform" type="rotate" values="6 4 -72;-12 4 -72;6 4 -72" dur="1.2s" repeatCount="indefinite" />
            <path d="M4 -72 L 52 -86" stroke="var(--ink)" stroke-width="6" stroke-linecap="round" />
            <path d="M52 -86 l9 -6 M52 -86 l8 6" stroke="var(--ink)" stroke-width="3" stroke-linecap="round" />
          </g>
        </g>
      </g>
    </g>

    <!-- wires -->
    <path d={P} fill="none" stroke="var(--ink-3)" stroke-width="2.5" stroke-linecap="round" />
    <path class="flow" d={P} fill="none" stroke="var(--violet)" stroke-width="3" stroke-linecap="round" />
    <!-- state coming back -->
    <path d="M640 168 C 640 214, 600 214, 560 214 H120 C 80 214, 63 190, 63 144" fill="none" stroke="var(--ink-3)" stroke-width="2" stroke-dasharray="3 6" stroke-linecap="round" />
    <text x="382" y="234" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="var(--ink-2)">st3215/inference · joint state streams back</text>

    <!-- pulses: two goals pass, the third is refused at the guard -->
    <g aria-hidden="true">
      <circle r="6" fill="var(--violet)"><animateMotion dur="3.6s" begin="-1.2s" repeatCount="indefinite" path="M118 112 H612" /></circle>
      <circle r="6" fill="var(--violet)"><animateMotion dur="3.6s" begin="-2.4s" repeatCount="indefinite" path="M118 112 H612" /></circle>
      <circle class="bad" r="6" cx="0" cy="0" fill="var(--coral)"><animateMotion dur="3.6s" begin="0s" repeatCount="indefinite" keyPoints="0;0.17;0.17;0.17" keyTimes="0;0.25;0.6;1" calcMode="linear" path="M118 112 H612" /></circle>
      <circle r="4" fill="var(--mint)"><animateMotion dur="2.4s" begin="-0.6s" repeatCount="indefinite" path="M640 168 C 640 214, 600 214, 560 214 H120 C 80 214, 63 190, 63 144" /></circle>
    </g>
    <text class="refused" x="224" y="70" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" font-weight="700" fill="var(--coral)">REFUSED</text>
  </svg>
</figure>

<style>
  .sp{margin:0;}
  .sp svg{width:100%;height:auto;display:block;}
  .flow{stroke-dasharray:12 16;animation:spflow 1.4s linear infinite;opacity:.85;}
  @keyframes spflow{to{stroke-dashoffset:-56;}}
  .bad{filter:drop-shadow(0 0 4px var(--coral));animation:spbad 3.6s linear infinite;}
  @keyframes spbad{0%,62%{opacity:1;}66%,100%{opacity:0;}}
  .refused{opacity:0;animation:sprefuse 3.6s linear infinite;animation-delay:0s;}
  @keyframes sprefuse{0%,23%{opacity:0;}26%,60%{opacity:1;}66%,100%{opacity:0;}}
  .guard{animation:spguard 3.6s linear infinite;animation-delay:0s;}
  @keyframes spguard{0%,22%{fill:var(--pop-mint);}26%,60%{fill:var(--coral-f);}70%,100%{fill:var(--pop-mint);}}
  @media (prefers-reduced-motion:reduce){ .flow,.refused,.guard,.bad{animation:none;} .sp g[aria-hidden]{display:none;} }
</style>
