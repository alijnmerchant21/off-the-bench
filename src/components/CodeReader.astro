---
// Clickable code: each highlighted line maps to an explanation panel.
interface Note { title: string; body: string; }
interface Props { file: string; code: string; notes: Record<string, Note>; }
const { file, code, notes } = Astro.props;
// A line ending in  # @key  is clickable. The marker is stripped from display.
const lines = code.replace(/\n$/, '').split('\n').map((raw) => {
  const m = raw.match(/\s*# @([a-z0-9-]+)\s*$/);
  return { text: m ? raw.slice(0, m.index) : raw, key: m ? m[1] : null };
});
const first = Object.keys(notes)[0];
---
<div class="breakout reader card" data-reader>
  <div class="src">
    <div class="file">{file}</div>
    <pre><code>{lines.map((l, i) => (
      <span class:list={['ln', { q: l.key }]} data-k={l.key ?? undefined} role={l.key ? 'button' : undefined} tabindex={l.key ? 0 : undefined}><span class="no">{i + 1}</span>{l.text || ' '}</span>
    ))}</code></pre>
  </div>
  <aside class="notes" aria-live="polite">
    {Object.entries(notes).map(([k, n]) => (
      <div class="rnote" data-k={k} hidden={k !== first}>
        <h4>{n.title}</h4>
        <p set:html={n.body} />
      </div>
    ))}
    <p class="hint">Click a highlighted line.</p>
  </aside>
</div>

<style>
  .reader{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);overflow:hidden;}
  .src{border-right:1px solid var(--line);min-width:0;}
  .file{font-family:var(--mono);font-size:11.5px;color:var(--ink-3);padding:10px 16px;border-bottom:1px solid var(--line);background:var(--surface-2);}
  pre{margin:0;padding:10px 0;overflow-x:auto;font-size:13px;line-height:1.7;background:var(--surface);}
  pre code{background:none;padding:0;font-size:inherit;display:block;min-width:max-content;}
  .ln{display:block;padding:0 16px 0 0;white-space:pre;border-left:3px solid transparent;}
  .no{display:inline-block;width:38px;text-align:right;padding-right:14px;color:var(--ink-3);user-select:none;opacity:.6;}
  .ln.q{cursor:pointer;background:var(--violet-f);background:color-mix(in srgb,var(--violet-f) 55%,transparent);}
  .ln.q:hover{background:var(--violet-f);}
  .ln.on{background:var(--violet-f);border-left-color:var(--violet);}
  .notes{padding:20px 22px;position:relative;}
  .rnote h4{font-size:17px;margin-bottom:8px;}
  .rnote p{font-size:15.5px;color:var(--ink-2);line-height:1.6;}
  .hint{font-family:var(--mono);font-size:11px;color:var(--ink-3);margin-top:16px;letter-spacing:.04em;}
  @media (max-width:820px){
    .reader{grid-template-columns:1fr;}
    .src{border-right:none;border-bottom:1px solid var(--line);}
    .notes{position:sticky;bottom:0;background:var(--surface);box-shadow:0 -8px 20px rgba(0,0,0,.06);}
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-reader]').forEach((root) => {
    const lines = root.querySelectorAll<HTMLElement>('.ln.q');
    const show = (k: string) => {
      lines.forEach((l) => l.classList.toggle('on', l.dataset.k === k));
      root.querySelectorAll<HTMLElement>('.rnote').forEach((n) => (n.hidden = n.dataset.k !== k));
    };
    lines.forEach((l) => {
      l.addEventListener('click', () => show(l.dataset.k!));
      l.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); show(l.dataset.k!); } });
    });
    const first = lines[0]?.dataset.k; if (first) show(first);
  });
</script>
