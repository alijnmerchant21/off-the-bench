---
import '../styles/global.css';

interface Props { title: string; description?: string; wide?: boolean; }
const { title, description = 'A hands-on, unofficial guide to NormaCore: what the stack does, how to run Station, and a simulated ElRobot you can program in the browser.' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links: [string, string][] = [
  ['/docs', 'Docs'],
  ['/lab', 'Lab'],
];
const active = (href: string) => path === href || path.startsWith(href + '/');
const fullTitle = title === 'Off the Bench' ? title : `${title} · Off the Bench`;
const AUTHOR = 'https://ali-the-curios.dev/';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Aliasgar Merchant" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta name="theme-color" content="#FBF6EA" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Mono:wght@400;600&family=Source+Sans+3:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  <script is:inline>
    // Light is the default for everyone. Dark only if the reader chose it with the toggle.
    (function(){
      var t = null;
      try { t = localStorage.getItem('otb-theme'); } catch (e) {}
      if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top">
    <div class="topin">
      <a class="brand" href="/" aria-label="Off the Bench, home">
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true">
          <defs><linearGradient id="mk" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--pop-lilac)"/><stop offset=".55" stop-color="var(--pop-sky)"/><stop offset="1" stop-color="var(--pop-mint)"/></linearGradient></defs>
          <rect x="1" y="1" width="30" height="30" rx="9" fill="url(#mk)" />
          <path d="M8 25 L13 15 L22 11" fill="none" stroke="#2B2638" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><circle cx="13" cy="15" r="2.4" fill="#2B2638"/><path d="M22 11 l4 -2 M22 11 l3 3" stroke="#2B2638" stroke-width="2.2" stroke-linecap="round"/><path d="M5 25.5 H12" stroke="#2B2638" stroke-width="2.6" stroke-linecap="round"/>
        </svg>
        <b>Off the Bench</b>
      </a>
      <nav class="nav" aria-label="Main">
        {links.map(([href, label]) => (
          <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>
        ))}
        <a class="play" href="/playground" aria-current={active('/playground') ? 'page' : undefined}>Playground</a>
      </nav>
      <button class="tgl" id="theme" type="button" aria-label="Switch to dark mode">
        <svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="progress" aria-hidden="true"></div>
  </header>

  <main id="main"><slot /></main>

  <footer class="foot">
    <div class="wrap footgrid">
      <div class="fcol about">
        <b class="fbrand">Off the Bench</b>
        <p>Built by <a href={AUTHOR} rel="author">Aliasgar Merchant</a>. Independent and unofficial. Not affiliated with NormaCore. NormaCore, ElRobot and Station are names of NormaCore projects, used here only to describe them. Official material lives at <a href="https://normacore.dev">normacore.dev</a> and on <a href="https://github.com/norma-core/norma-core">GitHub</a>.</p>
      </div>
      <nav class="fcol" aria-label="Learn">
        <b>Learn</b>
        <a href="/">What NormaCore builds</a>
        <a href="/playground">Playground</a>
        <a href="/docs/concepts">Key concepts</a>
      </nav>
      <nav class="fcol" aria-label="Build">
        <b>Build</b>
        <a href="/docs">Docs</a>
        <a href="/docs/quickstart">Quickstart</a>
        <a href="/lab">Lab results</a>
        <a href="/lab#data">Raw data</a>
      </nav>
      <nav class="fcol" aria-label="Community">
        <b>Community</b>
        <a href="https://discord.com/invite/Z4Ytw3QfHP">NormaCore Discord</a>
        <a href="https://github.com/norma-core/norma-core">norma-core on GitHub</a>
        <a href={AUTHOR}>About the author</a>
      </nav>
    </div>
  </footer>

  <script is:inline>
    (function(){
      var root = document.documentElement, btn = document.getElementById('theme');
      function label(){ btn.setAttribute('aria-label', root.getAttribute('data-theme') === 'dark' ? 'Switch to light mode' : 'Switch to dark mode'); }
      label();
      btn.addEventListener('click', function(){
        var dark = root.getAttribute('data-theme') === 'dark';
        if (dark) root.removeAttribute('data-theme'); else root.setAttribute('data-theme', 'dark');
        try { localStorage.setItem('otb-theme', dark ? 'light' : 'dark'); } catch (e) {}
        label();
        window.dispatchEvent(new Event('otb-theme'));
      });
    })();
  </script>
  <script is:inline>
    // Motion. Decoration only: skipped entirely when the reader prefers reduced motion.
    (function(){
      if (!window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
      var root = document.documentElement;
      root.classList.add('anim');

      // Hero headline: one span per word so the words can rise in turn.
      var h1 = document.querySelector('.hero h1');
      if (h1 && !h1.children.length) {
        var words = h1.textContent.trim().split(/\s+/);
        h1.setAttribute('aria-label', words.join(' '));
        h1.textContent = '';
        words.forEach(function(w, i){
          var s = document.createElement('span');
          s.className = 'w'; s.textContent = w; s.style.setProperty('--i', i); s.setAttribute('aria-hidden', 'true');
          h1.appendChild(s);
          if (i < words.length - 1) h1.appendChild(document.createTextNode(' '));
        });
      }

      // Hero glow follows the pointer.
      var hero = document.querySelector('.hero');
      if (hero && matchMedia('(pointer: fine)').matches) {
        var raf = 0;
        hero.addEventListener('pointermove', function(e){
          if (raf) return;
          raf = requestAnimationFrame(function(){
            raf = 0;
            var r = hero.getBoundingClientRect();
            hero.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100).toFixed(1) + '%');
            hero.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100).toFixed(1) + '%');
          });
        });
      }

      // Reveal on scroll, staggered within each group.
      var rise = '.hero .kicker,.hero .lede,.hero .cta,.hero-fig,.sh,.how-text > *,.ops,.forumcta,.pagehead > *,.checked,.nextprev';
      var pop = '.layer,.claim,.timeline li,.try,.find';
      document.querySelectorAll(rise).forEach(function(el){ el.setAttribute('data-reveal', ''); });
      document.querySelectorAll(pop).forEach(function(el){ el.setAttribute('data-reveal', 'pop'); });
      document.querySelectorAll('.ops .chip').forEach(function(el, i){ el.style.setProperty('--c', i); });

      function countUp(el){
        var full = el.textContent, m = /^(\d+)(\D*)$/.exec(full.trim());
        if (!m) return;
        var end = +m[1], t0 = performance.now(), dur = 1100;
        (function tick(t){
          var k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
          el.textContent = k < 1 ? Math.round(end * e) + m[2] : full;
          if (k < 1) requestAnimationFrame(tick);
        })(t0);
      }

      var io = new IntersectionObserver(function(entries){
        var n = 0;
        entries.forEach(function(en){
          if (!en.isIntersecting) return;
          var el = en.target;
          el.style.setProperty('--i', n++);
          el.classList.add('in');
          io.unobserve(el);
          el.querySelectorAll('.fx').forEach(countUp);
        });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      document.querySelectorAll('[data-reveal]').forEach(function(el){ io.observe(el); });
    })();
  </script>
</body>
</html>
