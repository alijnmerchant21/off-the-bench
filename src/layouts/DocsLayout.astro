---
// Documentation layout, following Google's developer documentation conventions:
// breadcrumb, title, one-sentence summary, task-based sections, an "On this page" list,
// last-updated date and previous / next links.
import Base from './Base.astro';
import { DOCS_NAV, DOCS_FLAT } from '../data/docs-nav';

const { frontmatter = {}, headings = [] } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '') || '/docs';
const idx = DOCS_FLAT.findIndex(([h]) => h === here);
const prev = idx > 0 ? DOCS_FLAT[idx - 1] : null;
const next = idx >= 0 && idx < DOCS_FLAT.length - 1 ? DOCS_FLAT[idx + 1] : null;
const group = DOCS_NAV.find((g) => g.items.some(([h]) => h === here))?.group;
const toc = headings.filter((h: { depth: number }) => h.depth === 2 || h.depth === 3);
---
<Base title={frontmatter.title} description={frontmatter.description}>
  <div class="docs">
    <aside class="dside" aria-label="Documentation">
      <details class="dmenu" open>
        <summary>Docs menu</summary>
        {DOCS_NAV.map((g) => (
          <div class="dgroup">
            <p>{g.group}</p>
            <ul>{g.items.map(([href, label]) => <li><a href={href} aria-current={href === here ? 'page' : undefined}>{label}</a></li>)}</ul>
          </div>
        ))}
      </details>
    </aside>

    <article class="dmain">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/docs">Docs</a>{group && group !== 'Get started' && <><span>/</span><span>{group}</span></>}
      </nav>
      <h1>{frontmatter.title}</h1>
      {frontmatter.summary && <p class="dsum">{frontmatter.summary}</p>}
      {frontmatter.tested && (
        <p class="tested"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{frontmatter.tested}</p>
      )}
      <div class="dbody prose-docs"><slot /></div>
      <footer class="dfoot">
        <p>Last updated {frontmatter.updated ?? '25 November 2026'}. {frontmatter.credit ? <Fragment set:html={frontmatter.credit + ' '} /> : <>NormaCore code and commands quoted from the <a href="https://github.com/norma-core/norma-core" rel="noopener" target="_blank">norma-core repository</a>, MIT License. </>}This guide is independent and unofficial.</p>
        <nav class="dpn" aria-label="Previous and next">
          {prev ? <a href={prev[0]}><span>Previous</span><b>{prev[1]}</b></a> : <span />}
          {next ? <a class="nx" href={next[0]}><span>Next</span><b>{next[1]}</b></a> : <span />}
        </nav>
      </footer>
    </article>

    <aside class="dtoc" aria-label="On this page">
      {toc.length > 1 && (
        <>
          <p>On this page</p>
          <ul>{toc.map((h: { depth: number; slug: string; text: string }) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </>
      )}
    </aside>
  </div>

  <script>
    // Copy buttons on every code block, and highlight the current section in "On this page".
    document.querySelectorAll<HTMLElement>('.prose-docs pre').forEach((pre) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'copy'; b.textContent = 'Copy';
      b.setAttribute('aria-label', 'Copy code');
      b.addEventListener('click', async () => {
        const text = pre.querySelector('code')?.innerText ?? pre.innerText;
        try { await navigator.clipboard.writeText(text); b.textContent = 'Copied'; }
        catch { const r = document.createRange(); r.selectNodeContents(pre); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); b.textContent = 'Selected'; }
        setTimeout(() => (b.textContent = 'Copy'), 1500);
      });
      const wrap = document.createElement('div'); wrap.className = 'codewrap';
      pre.parentNode!.insertBefore(wrap, pre); wrap.appendChild(pre); wrap.appendChild(b);
    });
    // Copy-link button on every section heading, so any section can be shared directly
    document.querySelectorAll<HTMLElement>('.prose-docs h2[id], .prose-docs h3[id]').forEach((h) => {
      const a = document.createElement('a');
      a.className = 'hlink'; a.href = '#' + h.id; a.setAttribute('aria-label', 'Copy link to this section'); a.textContent = '#';
      a.addEventListener('click', async (ev) => {
        ev.preventDefault();
        const url = location.origin + location.pathname + '#' + h.id;
        history.replaceState(null, '', '#' + h.id);
        try { await navigator.clipboard.writeText(url); a.textContent = 'Link copied'; a.classList.add('done'); } catch { a.textContent = '#'; }
        setTimeout(() => { a.textContent = '#'; a.classList.remove('done'); }, 1600);
      });
      h.appendChild(a);
    });
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.dtoc a')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
    if (targets.length) {
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.hash === '#' + e.target.id)); });
      }, { rootMargin: '-15% 0px -75% 0px' });
      targets.forEach((t) => io.observe(t));
    }
  </script>
</Base>

<style>
  .docs{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:230px minmax(0,1fr) 200px;gap:36px;padding-top:28px;}
  @media (max-width:1100px){ .docs{grid-template-columns:220px minmax(0,1fr);} .dtoc{display:none;} }
  @media (max-width:820px){ .docs{grid-template-columns:1fr;gap:16px;} }
  .dside{position:sticky;top:calc(env(safe-area-inset-top,0px) + 72px);align-self:start;max-height:calc(100vh - 90px);overflow:auto;}
  .dmenu summary{display:none;}
  @media (max-width:820px){
    .dside{position:static;max-height:none;}
    .dmenu{border:1px solid var(--line-2);border-radius:var(--r-sm);background:var(--surface);padding:6px 12px;}
    .dmenu summary{display:block;cursor:pointer;font-weight:700;padding:6px 0;}
  }
  .dgroup p{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);font-weight:600;margin:14px 0 6px;}
  .dgroup:first-of-type p{margin-top:0;}
  .dgroup ul{list-style:none;margin:0;padding:0;border-left:2px solid var(--line);}
  .dgroup a{display:block;padding:5px 12px;margin-left:-2px;border-left:2px solid transparent;text-decoration:none;color:var(--ink-2);font-size:14.5px;line-height:1.35;}
  .dgroup a:hover{color:var(--ink);border-left-color:var(--line-2);}
  .dgroup a[aria-current="page"]{color:var(--violet);font-weight:700;border-left-color:var(--violet);background:linear-gradient(90deg,var(--violet-f),transparent);}

  .dmain{min-width:0;max-width:780px;}
  .crumbs{font-size:13.5px;color:var(--ink-3);display:flex;gap:6px;flex-wrap:wrap;}
  .crumbs a{color:var(--ink-2);}
  .dmain h1{font-size:clamp(30px,4vw,40px);font-weight:800;letter-spacing:-.025em;margin-top:8px;}
  .dsum{font-size:19px;color:var(--ink-2);margin-top:10px;line-height:1.5;}
  .tested{display:inline-flex;align-items:center;gap:6px;margin-top:14px;font-size:13.5px;font-weight:600;color:#2B2638;background:var(--pop-mint);border-radius:99px;padding:4px 12px 4px 9px;}
  .dfoot{margin-top:56px;border-top:1px solid var(--line);padding-top:18px;}
  .dfoot > p{font-size:13.5px;color:var(--ink-3);}
  .dfoot > p a{color:var(--ink-2);}
  .dpn{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px;}
  .dpn a{display:block;padding:12px 16px;border:1px solid var(--line-2);border-radius:var(--r-sm);text-decoration:none;color:var(--ink);background:var(--surface);}
  .dpn a:hover{border-color:var(--violet);}
  .dpn span{display:block;font-family:var(--mono);font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:var(--ink-3);}
  .dpn b{font-family:var(--disp);font-size:16px;}
  .dpn .nx{text-align:right;}

  .dtoc{position:sticky;top:calc(env(safe-area-inset-top,0px) + 72px);align-self:start;font-size:13.5px;}
  .dtoc p{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-3);font-weight:600;margin-bottom:8px;}
  .dtoc ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;}
  .dtoc .d3{padding-left:12px;}
  .dtoc a{color:var(--ink-2);text-decoration:none;line-height:1.35;display:block;}
  .dtoc a:hover,.dtoc a.on{color:var(--violet);}
  .dtoc a.on{font-weight:700;}
</style>

<style is:global>
  .prose-docs{margin-top:22px;font-size:16.5px;line-height:1.7;}
  .prose-docs > * + *{margin-top:16px;}
  .prose-docs h2{font-size:25px;font-weight:800;letter-spacing:-.02em;margin-top:44px;scroll-margin-top:90px;}
  .prose-docs h3{font-size:19px;margin-top:30px;scroll-margin-top:90px;}
  .prose-docs h2 + *,.prose-docs h3 + *{margin-top:10px;}
  .prose-docs .hlink{margin-left:10px;font-family:var(--mono);font-size:.7em;font-weight:600;color:var(--ink-3);text-decoration:none;opacity:0;transition:opacity .15s;vertical-align:middle;border-radius:6px;padding:2px 6px;}
  .prose-docs h2:hover .hlink,.prose-docs h3:hover .hlink,.prose-docs .hlink:focus-visible,.prose-docs .hlink.done{opacity:1;}
  .prose-docs .hlink:hover{color:var(--violet);background:var(--surface-2);}
  .prose-docs .hlink.done{color:var(--violet);}
  @media (hover:none){ .prose-docs .hlink{opacity:.6;} }
  .prose-docs ol,.prose-docs ul{padding-left:24px;}
  .prose-docs li + li{margin-top:8px;}
  .prose-docs li > * + *{margin-top:10px;}
  .prose-docs ol > li::marker{font-family:var(--mono);font-weight:700;color:var(--violet);}
  .prose-docs table{width:100%;border-collapse:collapse;font-size:15px;display:block;overflow-x:auto;}
  .prose-docs th,.prose-docs td{text-align:left;padding:8px 12px;border-bottom:1px solid var(--line);vertical-align:top;}
  .prose-docs th{font-family:var(--mono);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);}
  .prose-docs td code{white-space:nowrap;}
  .codewrap{position:relative;max-width:100%;min-width:0;}
  .prose-docs li{min-width:0;}
  .prose-docs pre{max-width:100%;box-sizing:border-box;border:1px solid var(--line);border-radius:var(--r-sm);padding:14px 16px;overflow-x:auto;font-size:13.5px;line-height:1.6;background:var(--surface-2) !important;}
  .prose-docs pre code{background:none;padding:0;font-size:inherit;}
  .codewrap .copy{position:absolute;top:8px;right:8px;border:1px solid var(--line-2);background:var(--surface);color:var(--ink-2);border-radius:99px;padding:2px 10px;font-size:11px;font-family:var(--mono);font-weight:600;opacity:0;transition:opacity .15s;}
  .codewrap:hover .copy,.codewrap .copy:focus{opacity:1;}
  @media (hover:none){ .codewrap .copy{opacity:1;} }
  :root[data-theme="dark"] .astro-code,:root[data-theme="dark"] .astro-code span{color:var(--shiki-dark) !important;}
</style>
